# Copy this file to .env and fill in only the keys you use.
# .env is in .gitignore, so your keys stay on your machine.
# touchstone never prints or logs these values.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: other providers (each user uses their own key)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# HF_TOKEN=

# Optional: your own OpenAI-compatible server
# CUSTOM_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=

# Ollama runs locally and needs no key. Change this only if Ollama is not on the default port.
OLLAMA_BASE_URL=http://localhost:11434
